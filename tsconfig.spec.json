{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "rootDir": ".",
    "module": "commonjs",
    "emitDecoratorMetadata": true,
    "allowJs": true,
    "types": [
      "jest",
      "node"
    ]
  },
  "files": [
    "test/setup-jest.ts"
  ],
  "include": [
    "test/**/*.test.ts",
    "src/**/*.d.ts"
  ]
}
