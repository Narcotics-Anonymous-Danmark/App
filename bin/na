#!/usr/bin/env bash
set -euo pipefail

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
REQUIRED_NODE_VERSION="16.13.0"

_run_node_cli() {
  exec node "$(dirname "$0")/../lib/cli.js" "$@"
}

is_nvm_installed() {
  if command -v nvm >/dev/null 2>&1; then
    return 0
  fi
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    return 0
  fi
  return 1
}

install_nvm() {
  echo "Installing nvm..."
  if command -v curl >/dev/null 2>&1; then
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.3/install.sh | bash
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.3/install.sh | bash
  else
    echo "Error: neither curl nor wget is available to install nvm." >&2
    return 1
  fi
}

source_nvm() {
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck disable=SC1090
    . "$NVM_DIR/nvm.sh"
    return 0
  fi
  return 1
}

is_node_installed() {
  command -v node >/dev/null 2>&1
}

node_version_matches() {
  if ! is_node_installed; then
    return 1
  fi
  local v
  v="$(node -v 2>/dev/null || echo '')"
  v="${v#v}"
  [ "$v" = "$REQUIRED_NODE_VERSION" ]
}

ensure_node_version() {
  if node_version_matches; then
    return 0
  fi

  echo "Installing/using Node $REQUIRED_NODE_VERSION via nvm..."
  nvm install "$REQUIRED_NODE_VERSION"
  nvm alias default "$REQUIRED_NODE_VERSION"
  nvm use "$REQUIRED_NODE_VERSION"
}

main() {
  if node_version_matches; then
    _run_node_cli "$@"
  fi

  if ! is_nvm_installed; then
    install_nvm || { echo "Failed to install nvm" >&2; exit 3; }
  fi

  if ! source_nvm; then
    echo "Failed to source nvm after installation" >&2
    exit 4
  fi

  ensure_node_version || { echo "Failed to ensure Node $REQUIRED_NODE_VERSION" >&2; exit 5; }

  _run_node_cli "$@"
}

main "$@"
